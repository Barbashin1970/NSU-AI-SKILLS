# Normalize line endings in the repo to LF so install.sh works on macOS/Linux
# regardless of the OS that committed it.
* text=auto eol=lf

# PowerShell stays CRLF for Windows friendliness
*.ps1 text eol=crlf

# Treat images as binary (none ship today, but future-proof)
*.png binary
*.jpg binary
*.webp binary
